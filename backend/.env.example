# ── App ──────────────────────────────────────────────────────────────────────
APP_NAME=SpiceSibyl API
# APP_VERSION is stamped by the Docker build from the git tag; leave unset here.
# APP_VERSION=
APP_ENV=production
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000

# ── Security ──────────────────────────────────────────────────────────────────
API_KEY=change-me
# Master secret for Fernet encryption of vaulted API keys AND workflow secrets
# ($secrets.<name> in graph workflows, roadmap fase 1) — CHANGE THIS.
# Rotating it invalidates previously stored secrets (they fail to decrypt).
VAULT_SECRET_KEY=change-me-in-production

# Graph workflows: only WF_*-prefixed env vars are exposed to expressions as $env.<NAME>
# (e.g. WF_API_BASE=https://api.example.com -> {{ $env.API_BASE }}).
# WF_EXAMPLE_VALUE=

# ── Authentication (Phase 13) ────────────────────────────────────────────────
# Secret used to sign JWT access/refresh tokens — CHANGE THIS in production.
JWT_SECRET_KEY=change-me-in-production
# Token lifetimes.
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=14
# Bootstrap admin, created on first boot when the users table is empty.
# REQUIRED on a fresh database — auth is mandatory, so without these nobody can
# log in. Existing pre-auth profiles are adopted by this admin.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password
# Per-user request rate limit (slowapi-style "N/second|minute|hour").
RATE_LIMIT_DEFAULT=60/minute
# Login guard (audit 2.5). RATE_LIMIT_DEFAULT is keyed by the authenticated
# user, so it cannot cover /v1/auth/login and /v1/auth/refresh — there is no
# user yet. This one is applied per client IP and per submitted email, and is
# deliberately much tighter: a human logs in a few times a minute, a script
# does not. On top of it, repeated failures for the same email lock it out for
# a window that grows with the number of failures (5/min, 15/15min, 30/hour).
RATE_LIMIT_AUTH=10/minute
# Take the client IP from X-Forwarded-For instead of the socket peer. Enable
# ONLY behind a reverse proxy you control and that overwrites the header: with
# the app directly exposed, a caller can forge it and get a fresh rate-limit
# key on every request. Left false, everyone behind the proxy shares one key.
TRUST_PROXY_HEADERS=false

# ── Multi-instance coordination ──────────────────────────────────────────────
# Leave these at their defaults for a single backend container. They only
# matter when several instances share one database.
#
# Where the rate-limit windows live. "memory" counts what this process saw, so
# N instances allow N times the configured rate; "database" shares the window
# (one row per admission in rate_limit_hits) at the cost of a write per call.
RATE_LIMIT_BACKEND=memory
# Where workflow run events are fanned out to SSE subscribers. "memory" is
# single-process; "database" routes them through run_events so a browser
# streaming from one instance sees a run executed by another.
WORKFLOW_BUS_BACKEND=memory
# Only the instance holding the scheduler lease fires due schedules, so several
# instances do not each start the same run. A single instance always wins it.
SCHEDULER_LEADER_ELECTION=true
# Lease lifetime: a crashed leader is replaced after at most this long. Keep it
# a small multiple of the 20s schedule poll interval.
SCHEDULER_LEASE_TTL_SECONDS=90

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost,http://localhost:80
# Public URL for DDNS / reverse-proxy access (auto-added to CORS_ORIGINS).
PUBLIC_URL=

# ── Database ──────────────────────────────────────────────────────────────────
DB_PATH=/data/spice_sibyl.db
# Shared aiosqlite connection-pool size (app/db/pool.py). Connections are reused
# across requests/tasks instead of opened per call. SQLite has a single writer,
# so a small pool is plenty; raise only if WAL read concurrency is the bottleneck.
DB_POOL_SIZE=5

# ── Models ────────────────────────────────────────────────────────────────────
DEFAULT_MODEL=ollama/qwen2.5:7b-instruct
LITELLM_PROVIDER=litellm
OLLAMA_API_BASE=http://host.docker.internal:11434
# Automatic model-catalog discovery refresh (set ENABLED=false or HOURS=0 to disable)
DISCOVERY_REFRESH_ENABLED=true
DISCOVERY_REFRESH_HOURS=12

# Multi-MCP orchestrator sidecar (agent/* models). Empty = disabled.
# The sidecar (agent_server.py) runs on the host next to the multi-mcp CLI.
ORCHESTRATOR_BASE_URL=http://host.docker.internal:8910/v1
# Read timeout (s) for an orchestrator turn (spawns Docker MCP sub-agents).
ORCHESTRATOR_TIMEOUT=300

# ── Provider API keys (set the ones you use) ─────────────────────────────────
OPENAI_API_KEY=dummy
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
MISTRAL_API_KEY=
CEREBRAS_API_KEY=
NVIDIA_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
HF_TOKEN=

# ── Telegram bot (leave empty to disable) ────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
TELEGRAM_DEFAULT_MODEL=

# ── Image generation (text-to-image) ─────────────────────────────────────────
# Comma-separated "provider:model" pairs tried in order with automatic fallback.
# Supported providers: gemini, huggingface, cloudflare, together_ai
IMAGE_GENERATION_CHAIN=gemini:gemini-2.5-flash-image,gemini:gemini-3.1-flash-image,gemini:gemini-3-pro-image,gemini:imagen-4.0-fast-generate-001,huggingface:black-forest-labs/FLUX.1-schnell,cloudflare:@cf/stabilityai/stable-diffusion-xl-base-1.0,together_ai:black-forest-labs/FLUX.1-schnell-Free

# ── Speech & multimodal workflow nodes (roadmap fase 15.5) ───────────────────
# Used by the audio.transcribe / image.ocr / image.generate / tts workflow
# nodes. Naming follows litellm's <provider>/<model>, so the API keys above are
# the same ones these use. image.generate reuses IMAGE_GENERATION_CHAIN.
#
# Transcription model for audio.transcribe (empty disables the node).
SPEECH_TRANSCRIPTION_MODEL=whisper-1
# Text-to-speech model and default voice for the `tts` node.
SPEECH_TTS_MODEL=tts-1
SPEECH_TTS_VOICE=alloy
# Vision model used by image.ocr. Empty falls back to DEFAULT_MODEL, which only
# works if that model accepts images — set it explicitly if yours does not.
VISION_OCR_MODEL=

# ── Phase 16: observability & ops ────────────────────────────────────────────
# Log output format: "json" for structured logs with request correlation.
LOG_FORMAT=text
# Optional bearer token guarding GET /api/v1/metrics (empty = open on internal net).
METRICS_TOKEN=
# Chat fallback chain — comma-separated "provider:model" tried after the requested
# model when a provider fails before emitting output. Empty = no fallback.
CHAT_FALLBACK_CHAIN=
# Max tool-call loop iterations per chat turn (for longer loops use workflows).
CHAT_MAX_TOOL_ITERATIONS=5
# Scheduled SQLite backups (snapshot to a mounted volume).
BACKUP_ENABLED=false
BACKUP_DIR=/data/backups
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION=7
# Application log level (DEBUG, INFO, WARNING, ERROR, CRITICAL).
LOG_LEVEL=INFO

# ── MCP tool calls & stdio guardrails (Phase 18 / 23.5) ──────────────────────
# Log every MCP tool call and its raw result (set false to silence noisy servers).
MCP_LOG_CALLS=true
# Truncate the logged raw output to this many chars (0 = no truncation).
MCP_LOG_MAX_CHARS=4000
# Allow spawning stdio MCP servers from the admin UI (false disables entirely).
MCP_STDIO_ENABLED=true
# Allowlist of command basenames permitted for stdio MCP servers.
MCP_ALLOWED_COMMANDS=docker,npx,uvx,uv,python,node,mcp-proxy

# ── Sandboxed code interpreter (python_exec built-in tool, Phase 18) ─────────
# Runs model-supplied Python in an isolated subprocess (false removes the tool).
CODE_INTERPRETER_ENABLED=true
# Wall-clock timeout (s) for one execution; also the CPU-seconds limit.
CODE_INTERPRETER_TIMEOUT=20
# Address-space (memory) cap for the sandbox process.
CODE_INTERPRETER_MEMORY_MB=512
# Truncate captured stdout/stderr to this many chars each.
CODE_INTERPRETER_MAX_OUTPUT_CHARS=8000

# ── Workflows / graph workflow engine (Phase 18 / 29) ────────────────────────
# Default / hard cap on agent-loop iterations for a workflow run.
WORKFLOW_DEFAULT_MAX_STEPS=20
WORKFLOW_MAX_STEPS_LIMIT=100
# Enable the schedule-trigger polling loop for visual graph workflows.
GRAPH_WORKFLOW_SCHEDULER_ENABLED=true
# Hard cap on nodes per graph to bound a single run.
GRAPH_WORKFLOW_MAX_NODES=200
# A schedule/event trigger auto-disables (and raises an in-app alert) after
# this many consecutive firing failures.
GRAPH_WORKFLOW_TRIGGER_MAX_FAILURES=5
# Max nodes executed concurrently within a single run wave.
GRAPH_WORKFLOW_MAX_CONCURRENT_NODES=8
# A workflow raises an in-app alert after this many consecutive failed runs.
GRAPH_WORKFLOW_RUN_FAILURE_ALERT_THRESHOLD=3
# Phase 33 (roadmap fase 2.4): at startup, resume runs left 'running'/'pending'
# by a crash/restart from their per-node checkpoints, and re-evaluate the
# per-workflow run queues (runs parked as 'queued' by max_concurrent_runs).
GRAPH_WORKFLOW_RESUME_ON_STARTUP=true
# Phase 35 (roadmap fase 4.2): workspace storage root for the file.read /
# file.write nodes and sqlite db.query databases. Node paths are always
# resolved INSIDE this directory (traversal outside it is rejected).
GRAPH_WORKFLOW_FILES_DIR=data/workflow_files
# Phase 35 (roadmap fase 4.4): hard cap on how long a human.approval node may
# wait for a decision, in seconds (default 7 days).
GRAPH_WORKFLOW_APPROVAL_MAX_TIMEOUT=604800
# Phase 38 (roadmap fase 6.3): hard cap on `while` node iterations — the node's
# own maxIterations (default 100) can never exceed this.
GRAPH_WORKFLOW_WHILE_MAX_ITERATIONS=1000
# Phase 38 (roadmap fase 6.6): global per-host rate limits for http.request /
# notify.webhook nodes — "host=rpm" pairs separated by commas, or a JSON object
# {"host": rpm}. Requests over the cap wait (never fail); the wait is reported
# as `rate_limited_s` in the node output. Empty = no global limits.
GRAPH_WORKFLOW_RATE_LIMITS=
# Phase 38 (roadmap fase 6.2): poll interval (seconds) for the file.watch /
# email.inbound triggers; a trigger's own `interval` can only slow it down.
GRAPH_WORKFLOW_WATCH_POLL_SECONDS=60
# Phase 40 (roadmap fase 8.3): step-debug session timeout (seconds). A run left
# `paused` in the debugger longer than this is auto-cancelled by the scheduler
# sweep so a forgotten session doesn't stay suspended forever. 0 disables it.
GRAPH_WORKFLOW_DEBUG_MAX_PAUSE=3600
# Phase 41 (roadmap fase 9): workflows as ecosystem tools.
# 9.1 — an active workflow with an input contract + expose_as_tool becomes a
# callable tool (llm.agent, other workflows, the chat, the MCP server). This
# caps the depth of a tool→workflow→tool chain so a self-referential workflow
# cannot recurse forever.
GRAPH_WORKFLOW_TOOL_MAX_DEPTH=3
# 9.3 — a chat session is kept this many seconds after its last message; idle
# sessions are purged by the scheduler sweep (0 disables expiry). The rolling
# history fed to the workflow is trimmed to this many conversation turns.
GRAPH_WORKFLOW_CHAT_SESSION_TTL=86400
GRAPH_WORKFLOW_CHAT_HISTORY_MAX_TURNS=20
# 9.4 — most operations turned into http.request nodes from one OpenAPI spec.
GRAPH_WORKFLOW_OPENAPI_MAX_OPERATIONS=100

# Phase 44 (roadmap fase 12): data and budget governance.
# 12.1 — fraction of a token/run budget (workflow or profile-wide) that
# triggers a one-time in-app soft warning for the current calendar-month period.
GRAPH_WORKFLOW_BUDGET_WARN_PCT=0.8
# 12.2 — global default run/node-run retention in days (0 = keep forever). A
# workflow's own retention override (editor → Budget & quotas) takes precedence;
# the scheduler sweep purges terminal (completed/failed/cancelled) runs past
# the cutoff. Never purges queued/pending/running/waiting/paused runs.
GRAPH_WORKFLOW_RUNS_RETENTION_DAYS=0

# Phase 45 (roadmap fase 13.3): Git sync of workflow definitions. Requires the
# `git` CLI on the backend image (bundled in backend/Dockerfile). Per-workflow
# repo/branch/token-secret/path are set via PUT /{id}/git-sync, not here.
# Local working-copy root — one clone per workflow at <dir>/<workflow_id>.
GRAPH_WORKFLOW_GIT_WORKDIR=data/git_sync
# Timeout (seconds) for each individual git subprocess call (clone/fetch/push/…).
GRAPH_WORKFLOW_GIT_TIMEOUT_SECONDS=30

# Phase 46 (roadmap fase 14): remote execution and scalability.
# 14.1 — a runner is considered offline once its last heartbeat is older than
# this many seconds; a node's runOn dispatch waits up to the job timeout for a
# result before applying its runOnFallback (fail|local); poll interval between
# job-status checks while waiting.
GRAPH_WORKFLOW_RUNNER_HEARTBEAT_TIMEOUT=90
GRAPH_WORKFLOW_RUNNER_JOB_TIMEOUT=120
GRAPH_WORKFLOW_RUNNER_POLL_INTERVAL=1.0
# 14.3 — per-run lease TTL (seconds): the process instance executing a run
# renews it on every checkpoint; a stale lease past this age is free for any
# instance (including a restarted one) to take over. Generic — inert on a
# single-process SQLite deployment.
GRAPH_WORKFLOW_LEASE_TTL_SECONDS=45
# 14.4 — message queue triggers: `db` persists messages in
# workflow_queue_messages (survives restarts), `memory` is per-process
# (lost on restart, zero setup — good for dev/tests). Poll interval for the
# queue.consume trigger.
GRAPH_WORKFLOW_QUEUE_DRIVER=db
GRAPH_WORKFLOW_QUEUE_POLL_SECONDS=5

# ── Phase 47 (roadmap fase 15) — connectors and multimodal nodes ─────────────
# ssh.exec node: comma-separated host allow-list (empty = allow any host) and a
# per-command wall-clock timeout. Credentials come from $secrets, never here.
GRAPH_WORKFLOW_SSH_ALLOWED_HOSTS=
GRAPH_WORKFLOW_SSH_TIMEOUT_SECONDS=30
# browser node (Playwright): per-action timeout. Needs the `playwright` package
# plus a browser installed in the backend image; the node raises a clear error
# when Playwright is missing instead of silently degrading.
GRAPH_WORKFLOW_BROWSER_TIMEOUT_SECONDS=30
# rss.read trigger: max new entries fired per poll (newest first).
GRAPH_WORKFLOW_RSS_MAX_ENTRIES=20

# ── Phase 48 (roadmap fase 16) — state and execution semantics ───────────────
# state.set/state.increment nodes: default TTL (seconds) for a key when the node
# leaves ttlSeconds unset. 0 = keys never expire by default.
GRAPH_WORKFLOW_STATE_DEFAULT_TTL_SECONDS=0
# Trigger idempotency (webhook/event): default dedup window (seconds) applied
# when a trigger sets a dedupKey but no dedupWindowSeconds. Repeat deliveries of
# the same key inside this window return the original run instead of a new one.
GRAPH_WORKFLOW_DEDUP_DEFAULT_WINDOW_SECONDS=3600

# ── Phase 50 (roadmap fase 18) — LLM quality ─────────────────────────────────
# llm.judge default score scale (1..N, higher is better) when the node leaves
# `scaleMax` unset. The pass/fail threshold defaults to 60% of this scale.
GRAPH_WORKFLOW_JUDGE_DEFAULT_SCALE_MAX=5

# ── Phase 51 (roadmap fase 19) — Custom Node SDK ─────────────────────────────
# Storage root for uploaded custom-node packages (manifest + python module).
GRAPH_WORKFLOW_CUSTOM_NODES_DIR=data/custom_nodes
# Require every uploaded package to carry a valid HMAC signature before install
# (workspace hardening). Off by default.
GRAPH_WORKFLOW_REQUIRE_SIGNED_NODES=false
# Shared secret used to verify (and, in `sibyl-wf node pack --sign-key`, produce)
# package signatures. Empty disables verification even when the flag above is on.
GRAPH_WORKFLOW_NODE_SIGNING_KEY=

# ── Phase 52 (roadmap fase 20) — Telegram as a workflow channel ──────────────
# Max size (MB) of an inbound Telegram file a `telegram` trigger fetches into the
# workspace storage; larger files are dropped.
GRAPH_WORKFLOW_TELEGRAM_MAX_FILE_MB=20

# ── SMTP — used by the notify.email workflow node (empty host = disabled) ────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Sender address; falls back to SMTP_USER when unset.
SMTP_FROM=
# STARTTLS on the connection (disable only for trusted local relays).
SMTP_STARTTLS=true

# ── Embeddings & RAG (Phase 17 / wikillm) ────────────────────────────────────
# Embedding provider chain for RAG — comma-separated "provider:model" pairs.
# Supported providers: ollama (local/free), gemini, mistral.
EMBEDDING_CHAIN=ollama:nomic-embed-text,gemini:text-embedding-004,mistral:mistral-embed
# Hybrid retrieval: fuse FTS5 lexical search with vector similarity (RRF).
RAG_HYBRID=true
# Candidates pulled from each retrieval arm before fusion / reranking.
RAG_CANDIDATE_POOL=30
# Reranker over the fused pool: "" / "none" (off) or "llm".
RAG_RERANK=
# Model used when RAG_RERANK=llm ("provider/model" id).
RAG_RERANK_MODEL=groq/llama-3.1-8b-instant
# sqlite-vec ANN table width — must match the embedding model output
# (nomic-embed-text / gemini text-embedding-004 = 768; mistral-embed = 1024).
EMBEDDING_DIM=768
# Use the sqlite-vec extension for the vector arm (false forces numpy scan).
RAG_USE_SQLITE_VEC=true
# Expand the seed candidate pool by one hop over the knowledge graph.
RAG_GRAPH_EXPAND=true

# ── GraphRAG: LLM extraction, communities, global search (Phase 28.d) ────────
# Opt-in LLM entity + relationship extraction at ingest time.
GRAPH_LLM_EXTRACT=false
# Model for LLM extraction. Empty = DEFAULT_MODEL. "provider/model" id.
GRAPH_EXTRACT_MODEL=
# Cap on the Markdown (chars) sent to the extractor, for cost control.
GRAPH_EXTRACT_MAX_CHARS=12000
# Generate LLM community summaries after a (re)build of the graph.
GRAPH_COMMUNITY_SUMMARY=false
# Model for community + global-search summarisation. Empty = GRAPH_EXTRACT_MODEL chain.
GRAPH_COMMUNITY_MODEL=
# Minimum entity nodes in a community before it is summarised.
GRAPH_COMMUNITY_MIN_SIZE=3
# Replace extractive wiki section summaries with LLM summaries at ingest.
WIKI_LLM_SUMMARY=false
# Model for wiki section summaries. Empty = GRAPH_COMMUNITY_MODEL chain.
WIKI_SUMMARY_MODEL=
# Enable the map-reduce global-search endpoint over community summaries.
GRAPHRAG_GLOBAL_SEARCH=true

# ── Per-profile persistent memory & auto-titling (Phase 19) ──────────────────
# Master switch for the memory feature (per-profile toggles live in the DB).
MEMORY_ENABLED=true
# Low-cost model for async memory extraction. Empty = DEFAULT_MODEL.
MEMORY_EXTRACTION_MODEL=
# Char budget for the <user_memory> block injected into the system prompt.
MEMORY_MAX_CHARS=2000
# Hard cap on stored memories per profile (oldest disabled ones pruned first).
MEMORY_MAX_ITEMS=100
# Generate a concise conversation title from the first exchange.
AUTO_TITLE_ENABLED=true
# Model used for titling. Empty = MEMORY_EXTRACTION_MODEL, then DEFAULT_MODEL.
TITLE_MODEL=

# ── http_request built-in tool (Phase 19) ────────────────────────────────────
# Optional comma-separated domain-suffix allowlist (empty = any public host;
# private IPs are always blocked).
HTTP_REQUEST_ALLOWED_DOMAINS=

# ── Response cache (Phase 19.c) ──────────────────────────────────────────────
# Exact-match cache of completed replies (in-memory, per-process).
RESPONSE_CACHE_ENABLED=true
RESPONSE_CACHE_TTL_SECONDS=600
RESPONSE_CACHE_MAX_ENTRIES=256

# ── Semantic response cache (Phase 26, extends 19.c) ─────────────────────────
# On an exact-match miss, replay a cached reply whose embedded last user message
# is within SEMANTIC_CACHE_THRESHOLD (cosine). Degrades to exact-match-only when
# no embedding provider is reachable.
SEMANTIC_CACHE_ENABLED=false
SEMANTIC_CACHE_THRESHOLD=0.92
# Cap on the most-recent entries the semantic scan considers per lookup.
SEMANTIC_CACHE_MAX_ENTRIES=256

# ── Reminders / timezone ─────────────────────────────────────────────────────
# IANA timezone used for Telegram reminder parsing and display (/remind).
TIMEZONE=Europe/Rome
